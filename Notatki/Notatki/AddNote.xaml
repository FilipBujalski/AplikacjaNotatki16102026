<Window x:Class="Notatki.AddNote"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Notatki"
        mc:Ignorable="d"
        Title="Nowa notatka" Height="420" Width="480">

    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16" MouseDown="Header_MouseDown">
            <TextBlock Text="Nowa notatka"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       FontSize="14"/>
        </DockPanel>

        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Anuluj" Width="90" Padding="8,6" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Zapisz" Width="90" Padding="8,6" Click="Save_Click"/>
        </StackPanel>

        <StackPanel>
            <TextBlock Text="Tytuł" FontWeight="Bold" Margin="0,0,0,6"/>
            <TextBox x:Name="TitleTextBox" Padding="6" Margin="0,0,0,14"/>

            <TextBlock Text="Treść" FontWeight="Bold" Margin="0,0,0,6"/>
            <TextBox x:Name="DescriptionTextBox" Height="150" Padding="6" AcceptsReturn="True" TextWrapping="Wrap"/>
        </StackPanel>
    </DockPanel>
</Window>